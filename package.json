{
  "name": "dsh-browser-agent",
  "version": "1.0.0",
  "description": "A minimal DeepSeek Harness browser agent extension.",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "tsc --noEmit && vite build --config vite.config.js",
    "build:dsh-plugin": "tsc --project dsh-plugin/tsconfig.json",
    "setup:dsh-profile": "node scripts/setup-dsh-browser-profile.mjs",
    "preview": "vite preview --config vite.config.js",
    "test": "echo \"No tests configured yet\""
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/chrome": "^0.0.270",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "keywords": [
    "deepseek",
    "browser-agent",
    "chrome-extension"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "type": "module"
}
