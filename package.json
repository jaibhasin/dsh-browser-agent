{
  "name": "dsh-browser-agent",
  "version": "1.0.0",
  "description": "A minimal DeepSeek Harness browser agent extension.",
  "private": true,
  "scripts": {
    "measure:memory": "node scripts/measure-memory.mjs",
    "benchmark:memory": "node evals/memory-benchmark/benchmark-memory.mjs",
    "report:memory": "node scripts/render-memory-report.mjs",
    "test:benchmark": "node --experimental-strip-types --test tests/benchmark-setup.test.mjs tests/benchmark-selection.test.mjs tests/benchmark-recording.test.mjs tests/benchmark-sites.test.mjs tests/memory-report.test.mjs",
    "dev": "vite --config vite.config.js",
    "build": "pnpm run build:dsh-plugin && tsc --noEmit && vite build --config vite.config.js",
    "build:dsh-plugin": "tsc --project dsh-plugin/tsconfig.json",
    "test:bridge-protocol": "node --experimental-strip-types tests/bridge-protocol.test.mjs",
    "test:provider-error": "node --experimental-strip-types --test tests/provider-error.test.mjs",
    "test:bridge": "pnpm test:bridge-protocol && pnpm --dir dsh-plugin run test:bridge",
    "test:image-attachments": "node --experimental-strip-types tests/image-attachments.test.mjs",
    "test:document-attachments": "node --experimental-strip-types tests/document-attachments.test.mjs",
    "test:document-converter": "pnpm run build:dsh-plugin && node tests/document-converter.test.mjs",
    "test:agent-tab": "node --experimental-strip-types tests/agent-tab.test.mjs",
    "test:attention": "node --experimental-strip-types tests/attention.test.mjs",
    "test:browser-retry-guard": "node --experimental-strip-types tests/browser-retry-guard.test.mjs",
    "test:shadow-dom": "node tests/shadow-dom.test.mjs",
    "test:tab-switch": "node --experimental-strip-types tests/tab-switch-state.test.mjs",
    "test:assistant-stream": "node --experimental-strip-types --test tests/assistant-stream.test.mjs",
    "test:browser-agent-instructions": "node --experimental-strip-types tests/browser-agent-instructions.test.mjs",
    "test:saved-task-store": "node --experimental-strip-types tests/saved-task-store.test.mjs",
    "test:chat-history": "node --experimental-strip-types tests/chat-history.test.mjs",
    "test:theme": "node --experimental-strip-types --test tests/theme.test.mjs",
    "test:voice": "node --experimental-strip-types --test tests/voice.test.mjs",
    "test:markdown-table": "node --experimental-strip-types --test tests/markdown-table.test.mjs",
    "test:saved-tasks": "node --experimental-strip-types --test tests/saved-tasks.test.mjs",
    "test:task-draft": "node --experimental-strip-types --test tests/task-draft.test.mjs",
    "setup:dsh-profile": "node scripts/setup-dsh-browser-profile.mjs",
    "preview": "vite preview --config vite.config.js",
    "test:install": "node --test tests/install.test.mjs",
    "test": "pnpm test:benchmark && pnpm test:agent-tab && pnpm test:attention && pnpm test:browser-retry-guard && pnpm test:tab-switch && pnpm test:assistant-stream && pnpm test:browser-agent-instructions && pnpm test:saved-task-store && pnpm test:chat-history && pnpm test:theme && pnpm test:voice && pnpm test:markdown-table && pnpm test:saved-tasks && pnpm test:task-draft && pnpm test:provider-error && pnpm test:image-attachments && pnpm test:document-attachments && pnpm test:document-converter && pnpm test:install && pnpm test:bridge-protocol"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.270",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "keywords": [
    "deepseek",
    "browser-agent",
    "chrome-extension"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "type": "module"
}
